# =============================================
# CONFIGURACIÓN DEL CHATBOT DE VENTAS
# =============================================
# Copia este archivo a .env y completa los valores

# --- Anthropic (Claude AI) ---
# Obtén tu clave en: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# --- Telegram Bot ---
# 1. Abre Telegram y busca @BotFather
# 2. Escribe /newbot y sigue las instrucciones
# 3. Copia el token que te da
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# --- WhatsApp ---
# No necesita token - usa sesión QR
# Al iniciar verás un QR en la terminal para escanear
WHATSAPP_SESSION_PATH=./sessions

# --- Restaurante ---
RESTAURANT_NAME=Restaurante Mi Sabor
RESTAURANT_PHONE=+57 300 123 4567
RESTAURANT_ADDRESS=Calle 123 #45-67, Bogotá
RESTAURANT_HOURS=Lunes a Sábado 11am-10pm, Domingos 12pm-8pm
CURRENCY_SYMBOL=$
CURRENCY_CODE=COP

# --- Contacto del agente humano ---
# Número o username de Telegram del administrador para escaladas
HUMAN_AGENT_TELEGRAM=@admin_username
HUMAN_AGENT_PHONE=+57 300 765 4321

# --- Base de datos ---
DB_PATH=./data/chatbot.db

# --- Plataformas activas (true/false) ---
ENABLE_TELEGRAM=true
ENABLE_WHATSAPP=true
